# --- Neon Postgres (pgvector) ---
# Create a Neon project, enable the `vector` extension, paste the pooled connection string.
DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Anthropic (Vercel AI SDK provider) ---
ANTHROPIC_API_KEY="sk-ant-..."
# Set to whatever Sonnet-class model you've standardized on for BlueAlly work.
ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- Embeddings ---
# "local-minilm"  -> all-MiniLM-L6-v2 via Transformers.js, 384-dim, in-process, no key (DEFAULT)
# "qwen3"         -> Qwen3-Embedding-0.6B via hosted inference, higher quality (set HF token below)
EMBEDDINGS_PROVIDER="local-minilm"
# Only needed if EMBEDDINGS_PROVIDER=qwen3
HF_TOKEN=""
